        "source": "const ONLINE_EVERY = 5;\n\nfunction afterSession() {\n  for (const p of plot.all(\"chloronite\")) {\n    if (p.dead || p.decayCycles === null) continue;\n    if (p.decayCycles < ONLINE_EVERY) {\n      const r = p.row, c = p.col;\n      p.break();\n      plot.place(\"chloronite\", r, c);\n    }\n  }\n}\n",
